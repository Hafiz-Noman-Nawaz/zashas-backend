              "raw": "{\n  \"title\": \"Lawn 3-Piece Set\",\n  \"category\": \"Unstitched Collection\",\n  \"price\": 5200,\n  \"discountedPrice\": 4700,\n  \"images\": [\"https://example.com/image-1.jpg\"],\n  \"fabric\": \"Lawn\",\n  \"colors\": [\"Ivory\", \"Rose\"],\n  \"stock\": 20,\n  \"tags\": [\"summer\", \"luxury\"],\n  \"isFeatured\": true,\n  \"isOnSale\": true,\n  \"isNewArrival\": true,\n  \"isVisible\": true\n}"
