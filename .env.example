NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/zasha-collections
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Authentication Secrets
JWT_ACCESS_SECRET=replace-with-strong-secret-32-chars-min
JWT_REFRESH_SECRET=replace-with-strong-secret-32-chars-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_COOKIE=refreshToken

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zasha_collections

# SMTP / Email Service (Order Confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Pakistani Payment Gateways ──────────────────────────
# JazzCash Sandbox / Production Credentials
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/checkout/success
JAZZCASH_SANDBOX=true

# Easypaisa Sandbox / Production Credentials
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/checkout/success
EASYPAISA_SANDBOX=true
